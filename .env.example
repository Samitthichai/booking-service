# --- Database ---
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=queueup
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable

# Full URL for golang-migrate / GORM (must match the values above)
DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/queueup?sslmode=disable

# --- pgAdmin ---
PGADMIN_EMAIL=you@example.com
PGADMIN_PASSWORD=your_pgadmin_password
PGADMIN_PORT=5050

# --- App ---
APP_PORT=8080
JWT_SECRET=generate_a_long_random_string
